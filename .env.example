# Environment variables for epub-ruby
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ═══════════════════════════════════════════════════════════════════════════
# API Keys (required for LLM mode)
# ═══════════════════════════════════════════════════════════════════════════

# DeepSeek API key
# Get it from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-

# OpenAI API key
# Get it from: https://platform.openai.com/
OPENAI_API_KEY=sk-

# Google Gemini API key
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# epub-ruby specific settings
# ═══════════════════════════════════════════════════════════════════════════

# Enable LLM processing (true/false)
EPUB_RUBY_USE_LLM=false

# LLM model name
EPUB_RUBY_LLM_MODEL=deepseek-v4-flash

# LLM base URL (for OpenAI-compatible APIs)
EPUB_RUBY_LLM_BASE_URL=https://api.deepseek.com

# Batch size for LLM API calls
EPUB_RUBY_BATCH_SIZE=60

# Maximum concurrent API calls (0 = unlimited)
EPUB_RUBY_MAX_CONCURRENT=0

# Output directory for processed EPUB files
# EPUB_RUBY_OUTPUT_DIR=/path/to/output

# GUI theme (light/dark)
EPUB_RUBY_GUI_THEME=light


# ═══════════════════════════════════════════════════════════════════════════
# Python & Development
# ═══════════════════════════════════════════════════════════════════════════

# Python output encoding
PYTHONIOENCODING=utf-8

# Disable Python bytecode caching (for development)
PYTHONDONTWRITEBYTECODE=1
